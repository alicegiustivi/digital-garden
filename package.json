    "@tiptap/suggestion": "^3.33.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jsdom": "^31.0.0",
    "metascraper": "^5.58.5",
    "metascraper-author": "^5.58.5",
    "metascraper-date": "^5.58.4",
